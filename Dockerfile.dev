FROM node:22.20-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
    fontconfig \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
&& rm -rf /var/lib/apt/lists/*

# Load-bearing for card news: the SVG renderer only names the font family and
# lets fontconfig resolve it (librsvg inside sharp ignores @font-face, verified
# by measurement - see docs/snaps-card-news.md). Without these fonts registered
# here, every card news slide renders Korean text as tofu boxes.
#
# Pretendard is the house font and covers Latin, Hangul and kana, but reading
# its cmap directly shows it carries no Han ideographs and no emoji. This image
# installs no other font, so a Xiaohongshu deck - Chinese is one of the ten
# channels snaps renders for - and any caption carrying an emoji came out as
# tofu boxes. fonts-noto-cjk fills in Han and fonts-noto-color-emoji the emoji,
# together roughly 70MB, which is the price of the text being legible at all.
COPY libraries/nestjs-libraries/src/snaps/cardnews/assets/fonts/*.otf /usr/share/fonts/truetype/pretendard/
RUN fc-cache -f

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]
