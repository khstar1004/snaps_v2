    "@remotion/renderer": "^4.0.434",
    "@types/pg": "^8.20.0",
    "@upstash/qstash": "^2.9.0",
    "@upstash/redis": "^1.36.2",
    "@vercel/blob": "^2.2.0",
    "googleapis": "^144.0.0",
    "html2canvas": "^1.4.1",
    "next": "16.1.6",
    "pg": "^8.21.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "^4.0.434",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
